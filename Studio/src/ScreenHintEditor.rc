#include <windows.h>
6401 DIALOGEX 0,0,330,215
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit hint list"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Enter one hint per line.", -1,8,8,305,12
    EDITTEXT 6410,8,23,314,159,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save",IDOK,214,190,50,17
    PUSHBUTTON "Cancel",IDCANCEL,272,190,50,17
END

6402 DIALOGEX 0,0,520,338
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit carousel"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Images (in playback order)",-1,8,8,190,12
    LISTBOX 6420,8,23,184,208,LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | LBS_NOINTEGRALHEIGHT
    CONTROL "",6421,"STATIC",SS_OWNERDRAW,200,23,312,142
    LTEXT "No image selected",6423,200,170,312,24
    LTEXT "Caption for this image (optional)",-1,200,198,300,12
    EDITTEXT 6422,200,213,312,55,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add image...",6424,8,236,88,18
    PUSHBUTTON "Change image...",6425,104,236,88,18
    PUSHBUTTON "Remove",6426,8,258,56,18
    PUSHBUTTON "Move up",6427,68,258,58,18
    PUSHBUTTON "Move down",6428,130,258,62,18
    PUSHBUTTON "Previous",6432,200,274,68,18
    PUSHBUTTON "Next",6433,274,274,68,18
    LTEXT "Seconds per image",-1,8,287,90,12
    EDITTEXT 6430,101,284,56,16,ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Shuffle images",6431,"BUTTON",BS_AUTOCHECKBOX | WS_TABSTOP,8,307,125,16
    LTEXT "Style and position: select Carousel caption in Layers.",-1,200,299,310,12
    DEFPUSHBUTTON "Save",IDOK,396,315,54,17
    PUSHBUTTON "Cancel",IDCANCEL,458,315,54,17
END

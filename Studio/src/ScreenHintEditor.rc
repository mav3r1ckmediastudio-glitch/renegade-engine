#include <windows.h>
6401 DIALOGEX 0,0,330,215
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit hint list"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Enter one hint per line.", -1,8,8,305,12
    EDITTEXT 6410,8,23,314,159,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save",IDOK,214,190,50,17
    PUSHBUTTON "Cancel",IDCANCEL,272,190,50,17
END

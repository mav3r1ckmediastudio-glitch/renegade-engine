cmake_minimum_required(VERSION 3.19)
# All consumers use the same content-addressed trio. Publish its receipt last,
# so an interrupted or corrupt cook is repaired on the next invocation.
set(source "${SOURCE_DIR}/Studio/assets/terrain/default_grass")
set(tile_count 32)
file(SHA256 "${SOURCE_DIR}/Tools/TerrainSurfacePacker.cpp" cooker_hash)
set(recipe "rgba-tga-v1/${tile_count}/${cooker_hash}")
foreach(map IN ITEMS ao roughness basecolor normal)
    set(input "${source}/default_grass_${map}.tga")
    file(SHA256 "${input}" hash)
    string(APPEND recipe "/${hash}")
    list(APPEND inputs "${input}")
endforeach()
string(SHA256 key "${recipe}")
set(product_dir "${CACHE_DIR}/${key}")
file(MAKE_DIRECTORY "${product_dir}" "${DESTINATION}")
file(LOCK "${product_dir}/cook.lock" GUARD PROCESS)
set(outputs)
set(hashes)
foreach(map IN ITEMS basecolor normal surface)
    set(product "${product_dir}/default_grass_${map}.tga")
    list(APPEND outputs "${product}")
    if(EXISTS "${product}")
        file(SHA256 "${product}" hash)
        list(APPEND hashes "${hash}")
    endif()
endforeach()
set(receipt "${product_dir}/sha256.txt")
set(expected "")
if(EXISTS "${receipt}")
    file(READ "${receipt}" expected)
endif()
list(LENGTH hashes count)
if(NOT count EQUAL 3 OR NOT hashes STREQUAL expected)
    message(STATUS "Cooking stock terrain grass")
    execute_process(COMMAND "${PACKER}" ${inputs} ${outputs} "${tile_count}"
        COMMAND_ERROR_IS_FATAL ANY)
    set(hashes)
    foreach(map IN ITEMS basecolor normal surface)
        set(product "${product_dir}/default_grass_${map}.tga")
        set(input_map "${map}")
        if(map STREQUAL "surface")
            set(input_map ao)
        endif()
        file(READ "${source}/default_grass_${input_map}.tga" dimensions OFFSET 12 LIMIT 4 HEX)
        file(READ "${product}" header LIMIT 18 HEX)
        string(LENGTH "${header}" header_chars)
        if(NOT header_chars EQUAL 36)
            message(FATAL_ERROR "Incomplete TGA header for cooked grass ${map}")
        endif()
        string(SUBSTRING "${header}" 0 6 type)
        string(SUBSTRING "${header}" 24 8 output_dimensions)
        string(SUBSTRING "${header}" 32 2 depth)
        string(SUBSTRING "${dimensions}" 0 2 w0)
        string(SUBSTRING "${dimensions}" 2 2 w1)
        string(SUBSTRING "${dimensions}" 4 2 h0)
        string(SUBSTRING "${dimensions}" 6 2 h1)
        math(EXPR required "18 + 4 * 0x${w1}${w0} * 0x${h1}${h0}")
        file(SIZE "${product}" actual)
        if(NOT type STREQUAL "000002" OR NOT depth STREQUAL "20" OR
           NOT output_dimensions STREQUAL dimensions OR NOT actual EQUAL required)
            message(FATAL_ERROR "Invalid or incomplete cooked grass ${map}")
        endif()
        file(SHA256 "${product}" hash)
        list(APPEND hashes "${hash}")
    endforeach()
    file(WRITE "${receipt}.tmp" "${hashes}")
    file(RENAME "${receipt}.tmp" "${receipt}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different
    ${outputs} "${DESTINATION}" COMMAND_ERROR_IS_FATAL ANY)

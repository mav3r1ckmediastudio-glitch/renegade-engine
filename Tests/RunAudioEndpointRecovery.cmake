if(NOT EXISTS "${AUDIO_PROOF}")
    message(FATAL_ERROR "Built native audio endpoint proof required")
endif()
execute_process(COMMAND "${AUDIO_PROOF}" "${AUDIO_MODE}"
    RESULT_VARIABLE _audio_result OUTPUT_VARIABLE _audio_out ERROR_VARIABLE _audio_err TIMEOUT 30)
message(STATUS "Audio endpoint ${AUDIO_MODE}: ${_audio_result}\n${_audio_out}\n${_audio_err}")
set(_audio_log "${_audio_out}\n${_audio_err}")
string(FIND "${_audio_log}" "AUDIO_ENDPOINT_UNAVAILABLE_NOT_READY_PASS" _audio_ready_marker)
if(AUDIO_MODE STREQUAL "missing")
    string(FIND "${_audio_log}" "No default audio output device" _audio_warning)
    if(NOT "${_audio_result}" STREQUAL "0" OR _audio_ready_marker EQUAL -1 OR _audio_warning EQUAL -1)
        message(FATAL_ERROR "Missing playback endpoint did not recover as unavailable audio")
    endif()
elseif(AUDIO_MODE STREQUAL "unexpected")
    string(FIND "${_audio_log}" "Assertion failed" _audio_assert)
    if("${_audio_result}" STREQUAL "0" OR _audio_assert EQUAL -1 OR NOT _audio_ready_marker EQUAL -1)
        message(FATAL_ERROR "Unexpected audio failure lost its fatal assertion")
    endif()
else()
    message(FATAL_ERROR "Unknown audio endpoint proof mode")
endif()

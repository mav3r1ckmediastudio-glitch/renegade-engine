cmake_minimum_required(VERSION 3.19)
project(RenegadeRendererOverlayFixture LANGUAGES CXX)
if(NOT WIN32)
    message(FATAL_ERROR "This fixture validates Windows UMA/wireframe composition")
endif()
file(WRITE "${CMAKE_BINARY_DIR}/dummy.cpp" "void renderer_overlay_fixture() {}\n")
foreach(target IN ITEMS WickedEngine_emb_shaders WickedEngine_ext_shaders)
    add_library(${target} STATIC "${CMAKE_BINARY_DIR}/dummy.cpp"
        "${CMAKE_SOURCE_DIR}/WickedEngine/WickedEngine/wiRenderer.cpp")
endforeach()
include("${UMA_MODULE}")
include("${WIREFRAME_MODULE}")
file(READ "${_wf_generated}" combined)
foreach(needle IN ITEMS
    "// UPLOAD heaps remain GENERIC_READ and cannot host unordered access."
    "if (desc.usage == Usage::DEFAULT)"
    "desc.bind_flags |= BindFlag::UNORDERED_ACCESS;")
    string(FIND "${combined}" "${needle}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Combined renderer lost UMA allocation policy: ${needle}")
    endif()
endforeach()
foreach(suffix IN ITEMS "" "_tessellation" "_mesh_shader" "_doublesided"
        "_tessellation_doublesided" "_mesh_shader_doublesided")
    string(FIND "${combined}" "PipelineState PSO_object_wire${suffix}_overlay;" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Combined renderer lost wireframe PSO: ${suffix}")
    endif()
endforeach()
foreach(target IN ITEMS WickedEngine_emb_shaders WickedEngine_ext_shaders)
    get_target_property(sources ${target} SOURCES)
    set(compiled_renderers 0)
    foreach(source IN LISTS sources)
        if(source MATCHES "wiRenderer")
            get_source_file_property(header_only "${source}"
                TARGET_DIRECTORY ${target} HEADER_FILE_ONLY)
            if(NOT header_only)
                math(EXPR compiled_renderers "${compiled_renderers}+1")
                if(NOT source STREQUAL _wf_generated)
                    message(FATAL_ERROR "${target} compiles an uncomposed renderer: ${source}")
                endif()
            endif()
        endif()
    endforeach()
    if(NOT compiled_renderers EQUAL 1)
        message(FATAL_ERROR "${target} must compile exactly one composed renderer")
    endif()
endforeach()
file(SHA256 "${_wf_generated}" combined_sha)
file(WRITE "${CMAKE_BINARY_DIR}/renderer-final.sha256" "${combined_sha}\n")
message(STATUS "RENDERER_UMA_WIREFRAME_COMPOSITION_PASS ${combined_sha}")

# Renegade Moonlit Clouds V1 source/wiring contract (no GPU required).
set(root "${CMAKE_CURRENT_LIST_DIR}/..")
function(expect path needle)
    file(READ "${root}/${path}" value)
    string(FIND "${value}" "${needle}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "Moonlit clouds missing '${needle}' in ${path}")
    endif()
endfunction()

expect("cmake/RenegadeNightSkyOverlay.cmake" "renegadeMoonCloudLighting.hlsli")
expect("cmake/RenegadeNightSkyOverlay.cmake" "RenegadeApplyMoonlightToClouds(")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "#include \"renegadeMoonCloudLighting.hlsli\"")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "RenegadeApplyMoonlightToClouds(cloudLightDirection, cloudLightIlluminance, GetWeather().moon_parameters, GetWeather().moon_orbit)")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "VolumetricCloudLighting(atmosphere, rayOrigin, sampleWorldPosition, cloudLightDirection, cloudLightIlluminance, cosTheta")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "worldPosition, worldDirection, sunDirection, sunIlluminance, tDepth")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "sunElevation >= -0.04f")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "sunElevation > -0.10f")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "smoothstep(0.10f, 0.30f, -sunElevation)")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "moonParameters.z <= 0.0f")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "lunarDirection.y <= 0.0f")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "phaseIllumination")
expect("EngineBridge/include/renegade/bridge/MoonService.h" "MoonDirection(MoonState")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "RenegadeMoonCloudLocality(")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "angleDistance")
expect("Tools/night_sky/renegadeMoonCloudLighting.hlsli" "return float2(1.0f, 0.040f + 0.38f * vicinity)")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "moonSoftFill * (0.16f + 0.84f * lightVisible)")
expect("WickedEngine/WickedEngine/shaders/volumetricCloud_renderCS.hlsl" "cloudLightIlluminance *= moonLocality.x")
expect("Tools/night_sky/renegadeMoon.hlsli" "moonHalo")
message(STATUS "Moonlit clouds locality and phase gating contract passed")

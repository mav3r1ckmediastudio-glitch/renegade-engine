foreach(stock_header IN ITEMS "IKWindow.h" "HumanoidWindow.h" "ExpressionWindow.h")
    string(FIND "${inspector}" "${stock_header}" stock_window)
    if(NOT stock_window EQUAL -1)
        message(FATAL_ERROR "Phase 7C must not embed Wicked stock editor window: ${stock_header}")
    endif()
endforeach()

message(STATUS "Phase 7C native IK/look-at/expression source contract passed")

if(NOT DEFINED RENEGADE_SOURCE_DIR)
    message(FATAL_ERROR "RENEGADE_SOURCE_DIR is required")
endif()

function(require_file path label)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Phase 7C missing ${label}: ${path}")
    endif()
endfunction()

function(require_text text needle label)
    string(FIND "${text}" "${needle}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Phase 7C source contract missing ${label}: ${needle}")
    endif()
endfunction()

set(service_header "${RENEGADE_SOURCE_DIR}/EngineBridge/include/renegade/bridge/CharacterAnimationControlService.h")
set(service_source "${RENEGADE_SOURCE_DIR}/EngineBridge/src/CharacterAnimationControlService.cpp")
set(inspector_header "${RENEGADE_SOURCE_DIR}/Studio/src/Phase7Gate7CCharacterControlsInspector.h")
set(inspector_source "${RENEGADE_SOURCE_DIR}/Studio/src/Phase7Gate7CCharacterControlsInspector.cpp")
set(animation_header "${RENEGADE_SOURCE_DIR}/Studio/src/Phase7Gate7AAnimationInspector.h")
set(root_cmake "${RENEGADE_SOURCE_DIR}/CMakeLists.txt")

require_file("${service_header}" "CharacterAnimationControlService header")
require_file("${service_source}" "CharacterAnimationControlService source")
require_file("${inspector_header}" "character controls inspector header")
require_file("${inspector_source}" "character controls inspector source")

file(READ "${service_source}" service)
file(READ "${inspector_source}" inspector)
file(READ "${animation_header}" animation)
file(READ "${root_cmake}" root)

require_text("${service}" "scene_->inverse_kinematics" "native IK component storage")
require_text("${service}" "ik->SetDisabled(state.disabled)" "native IK enable state")
require_text("${service}" "humanoid->SetLookAtEnabled(state.enabled)" "native humanoid look-at")

require_text("${service}" "expression.SetDirty()" "native expression dirty propagation")
require_text("${service}" "SetInverseKinematicsStateCommand" "command-backed IK edits")
require_text("${service}" "SetHumanoidLookAtStateCommand" "command-backed look-at edits")
require_text("${service}" "SetExpressionMasterStateCommand" "command-backed expression automation")
require_text("${service}" "SetExpressionEntryStateCommand" "command-backed expression weights")

require_text("${inspector}" "ADD IK" "creator IK authoring")
require_text("${inspector}" "LOOK-AT // native humanoid head + eye solver" "creator look-at surface")
require_text("${inspector}" "BLINKS / SEC" "creator blink controls")

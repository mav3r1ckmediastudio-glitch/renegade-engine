if(NOT DEFINED RENEGADE_SOURCE_DIR)
    message(FATAL_ERROR "RENEGADE_SOURCE_DIR is required")
endif()

file(READ "${RENEGADE_SOURCE_DIR}/Studio/src/MarkerIconOverlay.cpp" markers)
foreach(needle IN ITEMS "FindAllEntities(" "HierarchyEntities(")
    string(FIND "${markers}" "${needle}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Marker visitor regressed to scene reconstruction: ${needle}")
    endif()
endforeach()

file(READ "${RENEGADE_SOURCE_DIR}/EngineBridge/src/SceneService.cpp" scene_source)
string(FIND "${scene_source}" "bool SceneService::ContainsEntity(" begin)
if(begin EQUAL -1)
    message(FATAL_ERROR "Point-query function moved; review its work-budget guard")
endif()
string(SUBSTRING "${scene_source}" ${begin} -1 query_tail)
string(FIND "${query_tail}" "wi::ecs::Entity SceneService::WeatherEntity()" end)
if(end EQUAL -1)
    message(FATAL_ERROR "Point-query boundary moved; review its work-budget guard")
endif()
string(SUBSTRING "${query_tail}" 0 ${end} query)
foreach(needle IN ITEMS "FindAllEntities(" "GetEntityArray(" "GetEntity("
        "HierarchyEntities(" "unordered_set" ".Serialize(")
    string(FIND "${query}" "${needle}" found)
    if(NOT found EQUAL -1)
        message(FATAL_ERROR "Point query regressed to enumeration/rebuild: ${needle}")
    endif()
endforeach()
message(STATUS "Editor point-query and marker work-budget source contract passed")

# Non-GPU integration contract: verifies Night Sky wiring without rebuilding Studio.
set(root "${CMAKE_CURRENT_LIST_DIR}/..")
function(require_contains relative token)
    file(READ "${root}/${relative}" source)
    string(FIND "${source}" "${token}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "Night Sky source contract failed: ${relative} missing '${token}'")
    endif()
endfunction()
require_contains("CMakeLists.txt" "include(cmake/RenegadeNightSkyOverlay.cmake)")
require_contains("cmake/RenegadeNightSkyOverlay.cmake" "renegadeAurora.hlsli")
require_contains("cmake/RenegadeNightSkyOverlay.cmake" "renegadeNightAtmosphere.hlsli")
require_contains("WickedEngine/WickedEngine/shaders/skyHF.hlsli" "RenegadeNightGradient(")
require_contains("WickedEngine/WickedEngine/shaders/skyHF.hlsli" "RenegadeAurora(")
require_contains("EngineBridge/include/renegade/bridge/NightSkyService.h" "renegade.night_sky.schema")
require_contains("EngineBridge/include/renegade/bridge/NightSkyService.h" "SetNightSkyCommand")
require_contains("Studio/src/NightSkyStudioIntegration.cpp" "LayoutEnvironmentSections")
require_contains("Studio/src/S1BInspectorSectionMigration.cpp" "LayoutEnvironmentSections();")
require_contains("Studio/src/NightSkyStudioIntegration.cpp" "CommitNightSlider")
require_contains("Studio/src/StudioApplication.cpp" "nightSkySliders_[i].SetValue")

file(READ "${root}/Studio/src/RenegadeStudioChrome.cpp" chrome)
if(chrome MATCHES "NightSkyWorkspace|NIGHT SKY")
 message(FATAL_ERROR "Separate Night Sky navigation must not return")
endif()

foreach(relative IN ITEMS Studio/src/StudioApplication.h Studio/src/StudioApplication.cpp Studio/src/RenegadeStudioChrome.h)
 file(READ "${root}/${relative}" source)
 if(source MATCHES "[Nn]ightSkyWorkspace")
  message(FATAL_ERROR "Obsolete Night Sky workspace state in ${relative}")
 endif()
endforeach()
foreach(group IN ITEMS "TIME OF DAY / SUN" "REALISTIC SKY" "CLOUDS" "STARS" "FOG" "OCEAN" "WEATHER / PRECIPITATION" "NIGHT ATMOSPHERE" "AURORA")
 require_contains("Studio/src/NightSkyStudioIntegration.cpp" "${group}")
endforeach()
require_contains("Studio/src/NightSkyStudioIntegration.cpp" "QueueInspectorRefresh();")
require_contains("Studio/src/NightSkyStudioIntegration.cpp" "child->SetVisible(visible && environmentSectionExpanded_[i]);")
message(STATUS "Night Sky source integration contract passed")

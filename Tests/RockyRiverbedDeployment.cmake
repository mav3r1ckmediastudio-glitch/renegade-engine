# Verify actual application outputs, not the proof executable's private copies.
foreach(required IN ITEMS RENEGADE_ROCKY_SOURCE RENEGADE_STUDIO_OUTPUT RENEGADE_RUNTIME_OUTPUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing application resource root: ${required}")
    endif()
endforeach()
foreach(resource IN ITEMS rocky_basecolor.png rocky_normal_dx.png rocky_surface.png material_manifest.json rocky_height_reference.png rocky_preview.jpg)
    set(source "${RENEGADE_ROCKY_SOURCE}/${resource}")
    if(NOT EXISTS "${source}")
        message(FATAL_ERROR "Missing source resource: ${resource}")
    endif()
    if(resource MATCHES "\\.png$")
        file(READ "${source}" png_signature LIMIT 8 HEX)
        if(NOT png_signature STREQUAL "89504e470d0a1a0a")
            message(FATAL_ERROR "Source resource is not a PNG image: ${resource}")
        endif()
    endif()
    file(SHA256 "${source}" expected_hash)
    foreach(application IN ITEMS RENEGADE_STUDIO_OUTPUT RENEGADE_RUNTIME_OUTPUT)
        set(installed "${${application}}/Content/terrain/riverbed/rocky_rugged/${resource}")
        if(NOT EXISTS "${installed}")
            message(FATAL_ERROR "${application} is missing rocky riverbed resource: ${resource}")
        endif()
        file(SHA256 "${installed}" installed_hash)
        if(NOT installed_hash STREQUAL expected_hash)
            message(FATAL_ERROR "${application} has a stale or different rocky riverbed resource: ${resource}")
        endif()
    endforeach()
endforeach()
message(STATUS "Studio and Runtime supplied rocky riverbed resources match source")

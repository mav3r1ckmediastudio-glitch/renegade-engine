if(NOT DEFINED RENEGADE_RIVER_PROOF OR NOT EXISTS "${RENEGADE_RIVER_PROOF}")
    message(FATAL_ERROR "A built native river proof is required")
endif()
if(NOT DEFINED RENEGADE_RIVER_OUTPUT_ROOT OR RENEGADE_RIVER_OUTPUT_ROOT STREQUAL "")
    message(FATAL_ERROR "A disposable proof output root is required")
endif()
# Never delete/overwrite a prior run: the native executable deliberately refuses it.
string(TIMESTAMP RUN_TIMESTAMP "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" RUN_NONCE)
set(RUN_OUTPUT "${RENEGADE_RIVER_OUTPUT_ROOT}/${RUN_TIMESTAMP}-${RUN_NONCE}")
if(EXISTS "${RUN_OUTPUT}")
    message(FATAL_ERROR "Refusing to overwrite earlier river proof evidence")
endif()
if(NOT DEFINED RENEGADE_RIVER_MODE)
    set(RENEGADE_RIVER_MODE default-recovery)
endif()
if(NOT RENEGADE_RIVER_MODE STREQUAL "default-recovery" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "terrain-initialization" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "maximum-expanded-first" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "maximum-linked-first")
    message(FATAL_ERROR "Unknown terrain recovery proof mode")
endif()
set(PREVIEW_ARGUMENTS)
if(RENEGADE_RIVER_MODE STREQUAL "terrain-initialization")
    if(NOT DEFINED RENEGADE_TERRAIN_PREVIEW_CHECKPOINT)
        set(RENEGADE_TERRAIN_PREVIEW_CHECKPOINT -1)
    endif()
    if(NOT RENEGADE_TERRAIN_PREVIEW_CHECKPOINT MATCHES "^(-1|[012])$")
        message(FATAL_ERROR "Unknown terrain preview checkpoint")
    endif()
    list(APPEND PREVIEW_ARGUMENTS "${RENEGADE_TERRAIN_PREVIEW_CHECKPOINT}")
endif()
message(STATUS "Terrain/river recovery evidence: ${RUN_OUTPUT}")
execute_process(
    COMMAND "${RENEGADE_RIVER_PROOF}" "${RUN_OUTPUT}" "${RENEGADE_RIVER_MODE}" ${PREVIEW_ARGUMENTS}
    RESULT_VARIABLE RIVER_RESULT)
if(NOT RIVER_RESULT EQUAL 0)
    message(FATAL_ERROR "Native terrain/river recovery failed: ${RIVER_RESULT}")
endif()

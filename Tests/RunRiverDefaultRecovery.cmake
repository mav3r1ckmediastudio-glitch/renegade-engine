if(NOT DEFINED RENEGADE_RIVER_PROOF OR NOT EXISTS "${RENEGADE_RIVER_PROOF}")
    message(FATAL_ERROR "A built native river proof is required")
endif()
if(NOT DEFINED RENEGADE_RIVER_OUTPUT_ROOT OR RENEGADE_RIVER_OUTPUT_ROOT STREQUAL "")
    message(FATAL_ERROR "A disposable proof output root is required")
endif()
# Never delete/overwrite a prior run: the native executable deliberately refuses it.
string(TIMESTAMP RUN_TIMESTAMP "%Y%m%dT%H%M%SZ" UTC)
string(RANDOM LENGTH 12 ALPHABET "0123456789abcdef" RUN_NONCE)
set(RUN_OUTPUT "${RENEGADE_RIVER_OUTPUT_ROOT}/${RUN_TIMESTAMP}-${RUN_NONCE}")
if(EXISTS "${RUN_OUTPUT}")
    message(FATAL_ERROR "Refusing to overwrite earlier river proof evidence")
endif()
if(NOT DEFINED RENEGADE_RIVER_MODE)
    set(RENEGADE_RIVER_MODE default-recovery)
endif()
if(NOT RENEGADE_RIVER_MODE STREQUAL "default-recovery" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "terrain-initialization" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "maximum-expanded-first" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "maximum-linked-first" AND
   NOT RENEGADE_RIVER_MODE STREQUAL "maximum-render")
    message(FATAL_ERROR "Unknown terrain recovery proof mode")
endif()
set(PREVIEW_ARGUMENTS)
if(RENEGADE_RIVER_MODE STREQUAL "terrain-initialization")
    if(NOT DEFINED RENEGADE_TERRAIN_PREVIEW_CHECKPOINT)
        set(RENEGADE_TERRAIN_PREVIEW_CHECKPOINT -1)
    endif()
    if(NOT RENEGADE_TERRAIN_PREVIEW_CHECKPOINT MATCHES "^(-1|[012])$")
        message(FATAL_ERROR "Unknown terrain preview checkpoint")
    endif()
    list(APPEND PREVIEW_ARGUMENTS "${RENEGADE_TERRAIN_PREVIEW_CHECKPOINT}")
endif()
if(RENEGADE_RIVER_MODE STREQUAL "maximum-render")
    if(NOT DEFINED RENEGADE_MAXIMUM_FIXTURE OR NOT EXISTS "${RENEGADE_MAXIMUM_FIXTURE}")
        message(FATAL_ERROR "A completed native maximum-terrain fixture is required")
    endif()
    file(STRINGS "${RENEGADE_MAXIMUM_FIXTURE}" FIXTURE_FIELDS)
    list(LENGTH FIXTURE_FIELDS FIXTURE_FIELD_COUNT)
    if(NOT FIXTURE_FIELD_COUNT EQUAL 3)
        message(FATAL_ERROR "Malformed maximum-terrain fixture manifest")
    endif()
    list(GET FIXTURE_FIELDS 0 FIXTURE_SCENE)
    list(GET FIXTURE_FIELDS 1 FIXTURE_SCENE_SHA256)
    list(GET FIXTURE_FIELDS 2 FIXTURE_PROOF_SHA256)
    if(NOT IS_ABSOLUTE "${FIXTURE_SCENE}" OR NOT EXISTS "${FIXTURE_SCENE}")
        message(FATAL_ERROR "Maximum-terrain fixture scene is missing")
    endif()
    file(SHA256 "${FIXTURE_SCENE}" ACTUAL_SCENE_SHA256)
    file(SHA256 "${RENEGADE_RIVER_PROOF}" ACTUAL_PROOF_SHA256)
    if(NOT ACTUAL_SCENE_SHA256 STREQUAL FIXTURE_SCENE_SHA256 OR
       NOT ACTUAL_PROOF_SHA256 STREQUAL FIXTURE_PROOF_SHA256)
        message(FATAL_ERROR "Maximum-terrain fixture scene or executable hash mismatch")
    endif()
    if(NOT RENEGADE_TERRAIN_PREVIEW_CHECKPOINT MATCHES "^(-2|1)$")
        message(FATAL_ERROR "Unknown maximum-terrain GPU checkpoint")
    endif()
    list(APPEND PREVIEW_ARGUMENTS "${FIXTURE_SCENE}" "${RENEGADE_TERRAIN_PREVIEW_CHECKPOINT}")
endif()
message(STATUS "Terrain/river recovery evidence: ${RUN_OUTPUT}")
execute_process(
    COMMAND "${RENEGADE_RIVER_PROOF}" "${RUN_OUTPUT}" "${RENEGADE_RIVER_MODE}" ${PREVIEW_ARGUMENTS}
    RESULT_VARIABLE RIVER_RESULT)
if(NOT RIVER_RESULT EQUAL 0)
    message(FATAL_ERROR "Native terrain/river recovery failed: ${RIVER_RESULT}")
endif()
if(RENEGADE_RIVER_MODE MATCHES "^maximum-(expanded-first|linked-first)$" AND
   DEFINED RENEGADE_MAXIMUM_FIXTURE)
    set(FIXTURE_SCENE "${RUN_OUTPUT}/maximum-linked-rivers.wiscene")
    if(NOT EXISTS "${FIXTURE_SCENE}")
        message(FATAL_ERROR "Successful native maximum proof did not save its scene")
    endif()
    file(SHA256 "${FIXTURE_SCENE}" FIXTURE_SCENE_SHA256)
    file(SHA256 "${RENEGADE_RIVER_PROOF}" FIXTURE_PROOF_SHA256)
    # The run-local manifest is immutable evidence. Only its consumer pointer
    # changes; earlier run directories and their scenes are never overwritten.
    set(FIXTURE_TEXT "${FIXTURE_SCENE}\n${FIXTURE_SCENE_SHA256}\n${FIXTURE_PROOF_SHA256}\n")
    file(WRITE "${RUN_OUTPUT}/completed-fixture.txt" "${FIXTURE_TEXT}")
    file(WRITE "${RENEGADE_MAXIMUM_FIXTURE}.${RUN_NONCE}.tmp" "${FIXTURE_TEXT}")
    file(RENAME "${RENEGADE_MAXIMUM_FIXTURE}.${RUN_NONCE}.tmp" "${RENEGADE_MAXIMUM_FIXTURE}")
endif()
